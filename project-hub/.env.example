# ── Database ─────────────────────────────────────────────────────────────
# App role: no BYPASSRLS, not table owner. Row-Level Security applies.
DATABASE_URL=postgres://projecthub_app:CHANGE_ME_app@localhost:5432/projecthub
# Owner role: runs migrations, auth bootstrap and the background worker.
DATABASE_OWNER_URL=postgres://projecthub_owner:CHANGE_ME_owner@localhost:5432/projecthub
# Superuser URL used once by `npm run db:setup` to create roles + database (local dev only).
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres

# ── App ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs file URLs.
APP_SECRET=CHANGE_ME_long_random_secret
STORAGE_DIR=./storage

# ── AI (mock by default; real provider only after approval) ─────────────
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5          # improve brief + task breakdown
AI_MODEL_LIGHT=claude-haiku-5-5   # summaries + next steps (cheaper)

# ── Email (mock mailbox by default) ─────────────────────────────────────
EMAIL_PROVIDER=mock         # mock | smtp
EMAIL_FROM="Project Hub <no-reply@example.com>"
SMTP_URL=

# ── SMS (mock only; live provider blocked pending sender registration) ─
SMS_PROVIDER=mock

# Optional: simulate outages in demos/tests
# AI_FORCE_UNAVAILABLE=1
# MOCK_EMAIL_FAIL=1
